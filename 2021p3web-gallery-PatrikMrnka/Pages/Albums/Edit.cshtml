@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Albums.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Album</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Album.AlbumId" />
            <div class="form-group">
                <label asp-for="Album.Name" class="control-label"></label>
                <input asp-for="Album.Name" class="form-control" />
                <span asp-validation-for="Album.Name" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Album.IsPublic" /> @Html.DisplayNameFor(model => model.Album.IsPublic)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Album.CreationDate" class="control-label"></label>
                <input asp-for="Album.CreationDate" class="form-control" />
                <span asp-validation-for="Album.CreationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Album.UploaderId" class="control-label"></label>
                <select asp-for="Album.UploaderId" class="form-control" asp-items="ViewBag.UploaderId"></select>
                <span asp-validation-for="Album.UploaderId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
