@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Albums.IndexModel

@{
    ViewData["Title"] = "Index";
}
    <h1 class="album_title">Moje alba</h1>
    <p class="album_PictureCount">Počet alb: @Model.AlbumCount</p>
    <div class="album_actionButtons">
        <div class="picture_action_flex_container">
            <a class="btn-gradient-1" asp-page="Create">Vytvořit nové album</a>
        </div>
    </div>
    <hr />
@if (Model.AlbumCount > 0)
{
    <div class="public_albums">
        @foreach (var item in Model.Albums) 
        {
            <div class="album_show">
                <div class="album_image">
                    <a asp-page="./Specificc/Index" asp-route-albumid="@item.AlbumId">
                        <div class="photo_container_index">
                            <img src="~/images/albumpicture.jpg">
                        </div>
                    </a>
                </div>
                <div class="album_name">
                    <a class="album_name_text" asp-page="./Specificc/Index" asp-route-albumid="@item.AlbumId">@item.Name</a>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>Nejsou nahrána žádná alba.</p>
}
