@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Albums.IndexModel

@{
    ViewData["Title"] = "Index";
}

    <p>
        <a asp-page="Create">Vytvořit nové album</a>
    </p>

    <h1>Moje alba</h1>
    <p>Počet alb: @Model.AlbumCount</p>

@if (Model.AlbumCount > 0)
{
    <table class="table">
    <thead>
        <tr>
            <th>Název</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Albums) {
        <tr>

            <td><a asp-page="./Specificc/Index" asp-route-albumid="@item.AlbumId">@item.Name</a></td>
        </tr>
}
    </tbody>
    </table>
}
else
{
    <p>Nejsou nahrána žádná alba.</p>
}
