@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Albums.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Soukromá alba</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Album[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Album[0].IsPublic)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Album[0].CreationDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Album[0].Uploader)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Album) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPublic)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreationDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Uploader.Email)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.AlbumId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.AlbumId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.AlbumId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

