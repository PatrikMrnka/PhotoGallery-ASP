@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Albums.IndexModel

@{
    ViewData["Title"] = "Index";
}

    <p>
        <a asp-page="Create">Vytvořit nové album</a>
    </p>

    <h1>Moje alba</h1>
    <p>Počet alb: @Model.AlbumCount</p>

@if (Model.AlbumCount > 0)
{
    <table class="table">
    <thead>
        <tr>
            <th>Název</th>
            <th>Veřejné </th>
            <th>Datum publikace </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Album) {
        <tr>

            <td><a asp-page="./Specific/Index" asp-route-id="@item.AlbumId" asp-route-name="@item.Name">@item.Name</a></td>
            <td>@item.IsPublic</td>
            <td>@item.CreationDate</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.AlbumId">Edit</a> |
                <a asp-page="./Delete" asp-route-id="@item.AlbumId">Delete</a>
            </td>
        </tr>
}
    </tbody>
    </table>
}
else
{
    <p>Nejsou nahrána žádná alba.</p>
}
