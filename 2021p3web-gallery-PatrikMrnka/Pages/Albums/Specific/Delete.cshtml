@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Albums.Specific.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>StoredFileAlbum</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StoredFileAlbum.Album)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StoredFileAlbum.Album.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StoredFileAlbum.Picture)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StoredFileAlbum.Picture.ContentType)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="StoredFileAlbum.AlbumId" />
        <input type="hidden" asp-for="StoredFileAlbum.PictureId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
