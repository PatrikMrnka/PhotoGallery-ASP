@page
@model IndexModel
@{
    ViewData["Title"] = "Titulní strana";
}

<h1>Nejnovější veřejné obrázky</h1>

@if (Model.PublicPicturesCount > 0) @*pokud jsou vytvořena veřejné fotky*@
{
    @foreach (var f in Model.Files.Where(a => a.IsPublic == true).Take(12).Reverse()) @*vypiš 12 fotek, které jsou veřejné*@
    {
            <img src="@Url.Page("/Index","Thumbnail", new {filename=f.Id })" />
@*            <a class="btn btn-sm btn-secondary" asp-page-handler="thumbnail" asp-route-filename="@f.Id">Thumbnail</a>*@
    }
}
else
{
    <p>Nejsou tu žádné nejnovější obrázky.</p>
}

<h1>Veřejná alba</h1> @*Všechna veřejná alba*@

@if (Model.PublicAlbumCount > 0) @*pokud jsou vytvořena veřejná alba*@
{
    @foreach (var a in Model.AlbumPublic) @*vypiš veřejná alba*@
    {
        <p><a asp-page="/Albums/Specific/Index" asp-route-id="@a.AlbumId" asp-route-name="@a.Name">@a.Name</a></p>
    }
}
else
{
    <p>Nejsou tu žádné veřejná alba</p>
}

