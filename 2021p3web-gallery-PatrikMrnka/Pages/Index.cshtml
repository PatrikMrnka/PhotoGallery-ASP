@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<h1>Nejnovější obrázky</h1>

@if (Model.Files.Where(a => a.IsPublic == true).ToList().Count > 0)
{
    @foreach (var f in Model.Files.Take(12).Reverse())
    {
            <img src="@Url.Page("/Index","Thumbnail", new {filename=f.Id })" />
    }
}
else
{
    <p>There are no files uploaded yet.</p>
}
