@using Microsoft.AspNetCore.Identity
@using _2021p3web_gallery_PatrikMrnka.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav_right"><a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@User.Identity?.Name</a></li>
    <li class="nav_right button">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post" >
            <button type="submit" class="nav_right">Odhlásit</button>
        </form>
    </li>
}
else
{
    <li class="nav_right"><a asp-area="Identity" asp-page="/Account/Register">Zaregistrovat</a></li>
    <li class="nav_right"><a asp-area="Identity" asp-page="/Account/Login">Přihlásit</a></li>    
}

