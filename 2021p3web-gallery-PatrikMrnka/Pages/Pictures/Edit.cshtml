@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Pictures.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>StoredFile</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="StoredFile.Id" />
            <input type="hidden" asp-for="StoredFile.UploadedAt" />
            <input type="hidden" asp-for="StoredFile.ContentType" />
            <input type="hidden" asp-for="StoredFile.OriginalName" />
            <input type="hidden" asp-for="StoredFile.UploaderId" />
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="StoredFile.IsPublic" /> @Html.DisplayNameFor(model => model.StoredFile.IsPublic)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
