@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Pictures.IndexModel

@{
    ViewData["Title"] = "Knihovna";
}

<h1>Knihovna</h1>

<p>
    <a asp-page="/Upload">Nahrát obrázek</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StoredFile[0].UploadedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StoredFile[0].OriginalName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StoredFile[0].ContentType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StoredFile[0].Uploader)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.StoredFile) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UploadedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OriginalName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ContentType)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

