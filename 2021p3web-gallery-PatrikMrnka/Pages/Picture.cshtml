@page
@model _2021p3web_gallery_PatrikMrnka.Pages.Albums.Specificc.PictureModel

@{
    ViewData["Title"] = "Picture";
}

@if (Model.PictureIdReceived == null && Model.AlbumIdReceived == null) // pokud není odkazováno na žádnou fotku a album
{
    <h1 class="album_title">Veřejné fotky</h1>
    <p class="album_PictureCount">Počet fotek: @Model.PublicPicturesCount</p>
    <hr class="line_between"/>
    <div class="album_actionButtons">
        <div class="newest_photos">
            @foreach (var item in Model.Files)
            {
                <a asp-page="./Picture" asp-route-pictureid="@item.Id">
                    <div class="photo_container_index">
                        <img src="@Url.Page("/Picture", "Thumbnail", new {filename=item.Id, pictureid=item.Id})">
                    </div>
                </a>
            }
        </div>
    </div>
}
else if (Model.PictureIdReceived == null && Model.AlbumIdReceived != null) // pokud je odkazováno pouze na album
{
    <p>Je odkazováno pouze na album. Nelze zobrazit fotku.</p>
}
else if (Model.PictureIdReceived != null && Model.AlbumIdReceived == null) // pokud je odkazováno pouze na fotku
{
    if (Model.Picture.IsPublic == false && Model.Picture.UploaderId != Model.UserId) // Pokud nevlastníš fotku a ani není veřejná
    {
        <p>Nelze zobrazit fotku, nejste její vlasatník, nebo není veřejná.</p>
    }
    else if (Model.Picture.IsPublic == true || Model.Picture.UploaderId == Model.UserId) // Pokud vlastníš fotku nebo je veřejná
    {
@*        <div class="flex-item">
            <div class="picture_action_description_flex_container">
                <div class="picture_description">
                    <h1>Popis</h1>
                    <p>@Model.Picture.OriginalName</p>
                    <p>@Model.Picture.UploadedAt</p>
                </div>
                <div class="picture_action">
                    <h2>Akce</h2>
                    <div class="picture_action_flex_container">
                        @if(Model.Picture.UploaderId == Model.UserId) // pokud jsem vlastník fotky
                        {
                            <a class="btn-gradient-1" asp-page="./Albums/Specificc/Add" asp-route-pictureid="@Model.Picture.Id">Přidat do alba</a>
                            <form asp-page-handler="DeletePhoto" asp-route-pictureid="@Model.Picture.Id" method="post">
                                <button class="btn-gradient-1">Smazat fotku</button>
                            </form>
                            @if (Model.Picture.IsPublic == true) // pokud jsem vlastník fotky a je veřejná
                            {
                                <form asp-page-handler="MakePhotoPrivate" asp-route-pictureid="@Model.Picture.Id" method="post">
                                    <button class="btn-gradient-1">Nastavit na soukromou</button>
                                </form>
                            }
                            else if (Model.Picture.IsPublic == false) // pokud jsem vlastník fotky a je soukromá
                            {
                                <form asp-page-handler="MakePhotoPublic" asp-route-pictureid="@Model.Picture.Id" method="post">
                                    <button class="btn-gradient-1">Nastavit na veřejnou</button>
                                </form>
                            }
                        }
                        else if(Model.Picture.IsPublic == true) // Pokud je fotka veřejná
                        {
                            <a class="btn-gradient-1" asp-page="./Albums/Specificc/Add" asp-route-pictureid="@Model.Picture.Id">Přidat do alba</a>
                        }
                    </div>
                </div>
            </div>
        </div>*@

        <div class="picture_flex">
            <div class="picture_info">
                <h1>@Model.Picture.OriginalName</h1>
                <p>@Model.Picture.UploadedAt</p>
                <div class="picture_action_buttons_flex">
                    @if(Model.Picture.UploaderId == Model.UserId) // pokud jsem vlastník fotky
                        {
                            <a class="btn-gradient-1" asp-page="./Albums/Specificc/Add" asp-route-pictureid="@Model.Picture.Id">Přidat do alba</a>
                            <form asp-page-handler="DeletePhoto" asp-route-pictureid="@Model.Picture.Id" method="post">
                                <button class="btn-gradient-1">Smazat fotku</button>
                            </form>
                            @if (Model.Picture.IsPublic == true) // pokud jsem vlastník fotky a je veřejná
                            {
                                <form asp-page-handler="MakePhotoPrivate" asp-route-pictureid="@Model.Picture.Id" method="post">
                                    <button class="btn-gradient-1">Nastavit na soukromou</button>
                                </form>
                            }
                            else if (Model.Picture.IsPublic == false) // pokud jsem vlastník fotky a je soukromá
                            {
                                <form asp-page-handler="MakePhotoPublic" asp-route-pictureid="@Model.Picture.Id" method="post">
                                    <button class="btn-gradient-1">Nastavit na veřejnou</button>
                                </form>
                            }
                        }
                        else if(Model.Picture.IsPublic == true) // Pokud je fotka veřejná
                        {
                            <a class="btn-gradient-1" asp-page="./Albums/Specificc/Add" asp-route-pictureid="@Model.Picture.Id">Přidat do alba</a>
                        }
                </div>
            </div>
            <hr>
            <div class="picture_self">
                <a>
                    <div class="photo_self_container">
                        <img src="@Url.Page("/Picture","FullSize", new {filename=Model.PictureIdReceived, pictureid=Model.PictureIdReceived})" />
                    </div>
                </a>
            </div>
        </div>

@*                <div class="picture_flex_container">
            <div class="flex_item picture_container">
                <div class="photo_container">
                    <img src="@Url.Page("/Picture","FullSize", new {filename=Model.PictureIdReceived, pictureid=Model.PictureIdReceived})" />
                </div>
            </div>
        </div>*@

    }
}