@page
@model _2021p3web_gallery_PatrikMrnka.Pages.UploadModel
@{
}

@if (@Model.AlbumIdReceived == null && @Model.PictureIdReceived == null) // obyčejný upload obrázku do Výchozího album
{
    <h1>Nahrát soubor</h1>
    <hr />

    <div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="Upload" class="control-label">File</label>
                <input type="file" asp-for="Upload" class="form-control-file" multiple required />
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="StoredFile.IsPublic" /> Veřejné
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Nahrát" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-page="/Index">Zpět</a>
            </div>
        </form>
    </div>
    </div>
}
else if (@Model.AlbumIdReceived != null && @Model.PictureIdReceived == null) // upravený upload obrázku do určitého odkázaného alba
{
    <h1>Nahrát soubor do @Model.Album.Name</h1>
    <hr />
        <div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="Upload" class="control-label">File</label>
                <input type="file" asp-for="Upload" class="form-control-file" multiple required />
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="StoredFile.IsPublic" /> Veřejné
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Nahrát" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-page="/Index">Zpět</a>
            </div>
        </form>
    </div>
    </div>
}