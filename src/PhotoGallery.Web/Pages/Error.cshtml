@page
@model ErrorModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Not found" : "Error";
}

<div class="text-center py-5">
    @if (Model.IsNotFound)
    {
        <h1 class="display-6">Page not found</h1>
        <p class="text-body-secondary">The page or photo does not exist, or you do not have access to it.</p>
    }
    else
    {
        <h1 class="display-6">Something went wrong</h1>
        <p class="text-body-secondary">An error occurred while processing your request.</p>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="small text-body-secondary">Request ID: <code>@Model.RequestId</code></p>
        }
    }
    <a class="btn btn-primary" asp-page="/Index">Go to Explore</a>
</div>
