@page "{id:guid}"
@model PhotoGallery.Web.Pages.Albums.DetailsModel
@{
    var album = Model.Details.Album;
    var isOwner = Model.Details.IsOwner;
    ViewData["Title"] = album.Name;
    var grid = new PhotoGridModel(
        Model.Details.Photos,
        AlbumId: album.Id,
        ShowVisibility: isOwner,
        EmptyText: isOwner ? "This album is empty. Upload photos or add existing ones from their detail page." : "This album has no public photos.");
}

<div class="mb-3">
    @if (isOwner)
    {
        <a class="link-secondary text-decoration-none" asp-page="/Albums/Index">&larr; My albums</a>
    }
    else
    {
        <a class="link-secondary text-decoration-none" asp-page="/Index">&larr; Explore</a>
    }
</div>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1 text-break">@album.Name</h1>
        <div class="d-flex flex-wrap align-items-center gap-2 small text-body-secondary">
            @if (album.IsDefault)
            {
                <span class="badge text-bg-secondary">Default</span>
            }
            else if (album.IsPublic)
            {
                <span class="badge text-bg-success">Public</span>
            }
            else
            {
                <span class="badge text-bg-dark">Private</span>
            }
            <span>@album.PhotoCount @(album.PhotoCount == 1 ? "photo" : "photos")</span>
            <span>· by @album.OwnerName</span>
            <span>· created @album.CreatedAt.ToString("d MMM yyyy")</span>
        </div>
    </div>

    <partial name="_SortSelect" model="Model.Sort" />
</div>

@if (isOwner)
{
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-primary btn-sm" asp-page="/Photos/Upload" asp-route-albumId="@(album.IsDefault ? null : album.Id.ToString())">Upload to this album</a>

        @if (album.IsDefault)
        {
            <span class="small text-body-secondary align-self-center">
                @GalleryService.DefaultAlbumName contains every photo you upload. It stays private and cannot be renamed or deleted.
            </span>
        }
        else
        {
            <form method="post" asp-page-handler="Visibility" asp-route-id="@album.Id"
                  data-confirm="@(album.IsPublic ? "" : "Make the album public? Your photos in it will become public too.")">
                <input type="hidden" name="isPublic" value="@(album.IsPublic ? "false" : "true")" />
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    @(album.IsPublic ? "Make private" : "Make public")
                </button>
            </form>

            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#renameForm"
                    aria-expanded="false" aria-controls="renameForm">
                Rename
            </button>

            <form method="post" asp-page-handler="Delete" asp-route-id="@album.Id"
                  data-confirm="Delete this album? The photos stay in @GalleryService.DefaultAlbumName.">
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete album</button>
            </form>
        }
    </div>

    @if (!album.IsDefault)
    {
        <div class="collapse mb-4" id="renameForm">
            <form method="post" asp-page-handler="Rename" asp-route-id="@album.Id" class="card card-body">
                <label for="name" class="form-label">Album name</label>
                <div class="input-group">
                    <input id="name" name="name" class="form-control" value="@album.Name" maxlength="@Album.NameMaxLength" required />
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    }
}

<partial name="_PhotoGrid" model="grid" />
