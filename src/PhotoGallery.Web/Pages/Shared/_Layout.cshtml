@inject IOptions<DemoOptions> DemoSettings
@{
    var demo = DemoSettings.Value;
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PhotoGallery – share photos and albums. ASP.NET Core Razor Pages demo application." />
    <title>@(string.IsNullOrEmpty(title) ? "PhotoGallery" : $"{title} · PhotoGallery")</title>
    <script>
        // Follow the operating system's light/dark preference.
        document.documentElement.setAttribute('data-bs-theme',
            window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md border-bottom bg-body-tertiary">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" asp-area="" asp-page="/Index">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="3" />
                        <circle cx="9" cy="9" r="2" />
                        <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" />
                    </svg>
                    PhotoGallery
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Explore</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Albums/Index">My albums</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
        @if (demo.Enabled)
        {
            <div class="demo-banner text-center small py-2 px-3">
                <strong>Live demo.</strong>
                Sign in as <code>@demo.Email</code> / <code>@demo.Password</code> or create your own account.
                Data is reset whenever the server restarts.
            </div>
        }
    </header>

    <main class="container py-4 flex-grow-1">
        <partial name="_StatusMessages" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 small text-body-secondary">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>PhotoGallery · ASP.NET Core Razor Pages</span>
            <a class="link-secondary" href="https://github.com/PatrikMrnka/PhotoGallery-ASP">Source code on GitHub</a>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
