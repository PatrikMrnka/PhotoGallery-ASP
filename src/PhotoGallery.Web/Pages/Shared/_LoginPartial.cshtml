@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav align-items-md-center gap-md-2">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="btn btn-primary btn-sm my-2 my-md-0" asp-area="" asp-page="/Photos/Upload">Upload</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Account settings">
                @UserDisplayName.From(User.Identity?.Name)
            </a>
        </li>
        <li class="nav-item">
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link">Sign out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-outline-primary btn-sm my-2 my-md-0" asp-area="Identity" asp-page="/Account/Register">Create account</a>
        </li>
    }
</ul>
